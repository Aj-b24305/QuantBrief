# ---------------------------------------------------------------------------
# RiskSentry configuration — copy to `.env` and adjust as needed.
# Every variable is optional; these are the defaults.
# ---------------------------------------------------------------------------

# --- Quantitative engine defaults ------------------------------------------
QUANTBRIEF_RISK_FREE_RATE=0.0525
QUANTBRIEF_DEFAULT_BENCHMARK=^NSEI
QUANTBRIEF_DEFAULT_LOOKBACK_DAYS=365

# --- LLM synthesizer -------------------------------------------------------
# Provider: ollama | openai | gemini
QUANTBRIEF_LLM_PROVIDER=ollama

# Local Ollama model.
# Recommended: granite4.2:3b (enterprise JSON) or llama3.1:8b (clean percentages)
QUANTBRIEF_LLM_MODEL=granite4.2:3b

# OpenAI-compatible endpoint overrides (provider defaults used when empty):
#   ollama -> base_url http://localhost:11434/v1, key ignored
#   openai -> base_url https://api.openai.com/v1, key from OPENAI_API_KEY
QUANTBRIEF_LLM_BASE_URL=
QUANTBRIEF_LLM_API_KEY=

# Hard cap on local Ollama HTTP requests (per request). Accepts the standard
# unprefixed name too; both map to the same setting.
OLLAMA_TIMEOUT_SECONDS=120
QUANTBRIEF_LLM_TIMEOUT_SECONDS=60
QUANTBRIEF_LLM_MAX_RETRIES=1
QUANTBRIEF_LLM_TEMPERATURE=0.2

# --- Gemini cloud fallback (OpenAI-compatible interface) -------------------
# Used when the local Ollama model is missing/unreachable or its output fails
# validation twice. Set GEMINI_API_KEY to enable; without it the pipeline ends
# at the deterministic fallback memo (never an HTTP 500).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

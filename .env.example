# ---------------------------------------------------------------------------
# QuantBrief configuration — copy to `.env` and adjust as needed.
# Every variable is optional; these are the defaults.
# ---------------------------------------------------------------------------

# --- Quantitative engine defaults ------------------------------------------
QUANTBRIEF_RISK_FREE_RATE=0.0525
QUANTBRIEF_DEFAULT_BENCHMARK=^NSEI
QUANTBRIEF_DEFAULT_LOOKBACK_DAYS=365
# Use SPY for large-cap US equity index, ^NSEI for Indian Nifty 50

# --- LLM synthesizer -------------------------------------------------------
# Provider: ollama | openai | gemini
QUANTBRIEF_LLM_PROVIDER=ollama

# Optional overrides (provider defaults are used when left empty):
#   ollama -> base_url http://localhost:11434/v1, model granite4.2:3b, key ignored
#   gemini -> base_url https://generativelanguage.googleapis.com/v1beta/openai/,
#             model gemini-2.0-flash, key from GEMINI_API_KEY
#   openai -> base_url https://api.openai.com/v1, model gpt-4o-mini,
#             key from OPENAI_API_KEY
QUANTBRIEF_LLM_BASE_URL=
QUANTBRIEF_LLM_API_KEY=
QUANTBRIEF_LLM_MODEL=
QUANTBRIEF_LLM_TIMEOUT_SECONDS=60
QUANTBRIEF_LLM_MAX_RETRIES=1
QUANTBRIEF_LLM_TEMPERATURE=0.2

# --- Gemini fallback (recommended — fires when Ollama times out) -----------
QUANTBRIEF_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
QUANTBRIEF_LLM_MODEL=gemini-2.0-flash
